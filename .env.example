# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Postgres
DATABASE_URL="postgresql://chui:chui@localhost:5432/chui_loyalty?schema=public"

# Redis (BullMQ queue for wallet push)
REDIS_URL="redis://localhost:6379"
# Run the wallet-push worker inside the same process as the HTTP server.
# In production, set this to "false" and run `npm run worker:start` separately.
RUN_WORKER_INLINE="true"

# Auth
JWT_SECRET="change-me-in-production-please-use-openssl-rand-base64-32"
JWT_EXPIRES_IN="7d"

# NFC token signing (HS256). Use a different key than JWT.
NFC_TOKEN_SECRET="change-me-too-openssl-rand-base64-32"

# Apple Wallet (PKPass)
# Generated in https://developer.apple.com/account/resources/identifiers/passTypeId
# In dev set *_PATH to local PEM files. In prod set *_B64 to the base64-
# encoded file contents (preferred for hosted platforms). When both are set,
# B64 wins.
APPLE_PASS_TYPE_IDENTIFIER="pass.com.chui.loyalty"
APPLE_TEAM_IDENTIFIER="ABCDE12345"
APPLE_PASS_CERT_PATH="./certs/pass.pem"
APPLE_PASS_CERT_B64=""
APPLE_PASS_KEY_PATH="./certs/pass.key"
APPLE_PASS_KEY_B64=""
APPLE_PASS_KEY_PASSPHRASE=""
APPLE_WWDR_CERT_PATH="./certs/wwdr.pem"
APPLE_WWDR_CERT_B64=""

# Google Wallet
# Service account from Google Cloud + Wallet API enabled
GOOGLE_WALLET_ISSUER_ID="0000000000000000000"
# In dev, point at the JSON file. In prod use the B64 form.
GOOGLE_WALLET_SERVICE_ACCOUNT_PATH="./certs/google-wallet-sa.json"
GOOGLE_WALLET_SA_JSON_B64=""

# Mercado Pago — public gift card purchase at /regalo.
# Credentials at https://www.mercadopago.com.ar/developers/panel
# Webhook secret at Notifications -> Webhooks -> "Clave secreta".
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""

# Resend — transactional email for gift card delivery.
# Sign up at https://resend.com (free up to 3k sends/month).
# Verify the chui.com.ar domain so emails come from hola@chui.com.ar.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Chuí <hola@chui.com.ar>"

# Absolute public URL used in emails and MP redirect URLs.
PUBLIC_BASE_URL="https://card.chui.com.ar"
