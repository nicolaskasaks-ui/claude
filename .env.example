# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Postgres
DATABASE_URL="postgresql://chui:chui@localhost:5432/chui_loyalty?schema=public"

# Redis (BullMQ queue for wallet push)
REDIS_URL="redis://localhost:6379"
# Run the wallet-push worker inside the same process as the HTTP server.
# In production, set this to "false" and run `npm run worker:start` separately.
RUN_WORKER_INLINE="true"

# Auth
JWT_SECRET="change-me-in-production-please-use-openssl-rand-base64-32"
JWT_EXPIRES_IN="7d"

# NFC token signing (HS256). Use a different key than JWT.
NFC_TOKEN_SECRET="change-me-too-openssl-rand-base64-32"

# Apple Wallet (PKPass)
# Generated in https://developer.apple.com/account/resources/identifiers/passTypeId
APPLE_PASS_TYPE_IDENTIFIER="pass.com.chui.loyalty"
APPLE_TEAM_IDENTIFIER="ABCDE12345"
APPLE_PASS_CERT_PATH="./certs/pass.pem"
APPLE_PASS_KEY_PATH="./certs/pass.key"
APPLE_PASS_KEY_PASSPHRASE=""
APPLE_WWDR_CERT_PATH="./certs/wwdr.pem"

# Google Wallet
# Service account from Google Cloud + Wallet API enabled
GOOGLE_WALLET_ISSUER_ID="0000000000000000000"
GOOGLE_WALLET_SERVICE_ACCOUNT_PATH="./certs/google-wallet-sa.json"
