{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx prisma generate && npx tsc -p tsconfig.json",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "{assets/**,prisma/**,dist/**,node_modules/.prisma/**,node_modules/@prisma/**}"
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "^/app/(.*)$", "dest": "/$1", "continue": true },
    { "src": "^/(.*)$", "dest": "/api" }
  ]
}
